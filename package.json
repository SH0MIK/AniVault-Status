{
  "name": "anivault-status",
  "version": "1.0.0",
  "private": true,
  "description": "Status page for anivault.co + api.anivault.co, deployed to status.anivault.co",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 execute anivault-status --local --file=./schema.sql",
    "db:migrate:remote": "wrangler d1 execute anivault-status --remote --file=./schema.sql",
    "db:migrate2:local": "wrangler d1 execute anivault-status --local --file=./migrations/0002_status_details.sql",
    "db:migrate2:remote": "wrangler d1 execute anivault-status --remote --file=./migrations/0002_status_details.sql",
    "tail": "wrangler tail"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.3.3",
    "wrangler": "^3.78.0"
  }
}
